# =============================================================
# ARIA Backend — Render Production Environment Variables
# Add these in: Render Dashboard → Service → Environment
# =============================================================

# ── OpenAI ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ── Database (Supabase) ───────────────────────────────────────────────────
# Get from: Supabase Dashboard → Project Settings → Database → Connection string
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend URL — backend calls Vercel Stagehand routes ─────────────────
# Set this AFTER deploying frontend to Vercel
FRONTEND_URL=https://your-app.vercel.app

# ── Web Search ────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
APIFY_API_KEY=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── ARIA Config ───────────────────────────────────────────────────────────
USE_ARIA_AGENT=true
ARIA_MAX_TOOL_ROUNDS=10
